# ─────────────────────────────────────────────────────────────
# FinSight — shared environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
# Postgres. Leave unset locally to fall back to SQLite.
DATABASE_URL=postgres://finsight:finsight@postgres:5432/finsight

# ---- JWT ----
JWT_SECRET_KEY=change-me-too-another-long-random-string
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- FastAPI analytics engine ----
FASTAPI_URL=http://fastapi:9000
FASTAPI_SERVICE_TOKEN=shared-service-to-service-secret
FASTAPI_TIMEOUT_SECONDS=8

# ---- Redis (optional cache / future Celery broker) ----
REDIS_URL=redis://redis:6379/0
ANALYTICS_CACHE_TTL_SECONDS=900

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend (Vite, must be prefixed with VITE_) ----
VITE_API_BASE_URL=http://localhost:8000/api

# ---- Postgres container bootstrap ----
POSTGRES_DB=finsight
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight
