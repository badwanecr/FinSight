# Backend-specific overrides. Values here take precedence over the repo-root .env.
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL empty to use SQLite for a zero-infra local run.
DATABASE_URL=
JWT_SECRET_KEY=dev-only-change-me-too
FASTAPI_URL=http://localhost:9000
FASTAPI_SERVICE_TOKEN=dev-service-token
FASTAPI_TIMEOUT_SECONDS=8
REDIS_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
