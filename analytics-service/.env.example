# Analytics engine configuration
ENVIRONMENT=development
FASTAPI_SERVICE_TOKEN=dev-service-token
# Set true in any shared/deployed environment to enforce the Django→FastAPI token.
REQUIRE_SERVICE_TOKEN=false
ZSCORE_THRESHOLD=3.0
IQR_MULTIPLIER=1.5
ISOLATION_FOREST_CONTAMINATION=0.05
MIN_GROUP_SIZE=5
MAX_TRANSACTIONS=100000
LOG_LEVEL=INFO
